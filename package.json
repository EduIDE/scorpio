{
  "name": "artemis-scorpio",
  "displayName": "Scorpio - EduIDE workspace bootstrap",
  "version": "0.0.0",
  "description": "Prepares an EduIDE workspace at session start: clones GIT_URI or copies a TEMPLATE into the empty workspace, sets the git identity and pre-warms Gradle.",
  "license": "MIT",
  "private": true,
  "categories": [
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/EduIDE/scorpio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EduIDE/scorpio.git"
  },
  "publisher": "aet-tum",
  "main": "./dist/extension.js",
  "scripts": {
    "install:all": "npm install --no-scripts",
    "build": "webpack --mode production",
    "watch": "webpack --watch",
    "install:extension": "npm install --no-scripts",
    "build:extension": "webpack --mode production",
    "compile:extension": "webpack",
    "watch:extension": "webpack --watch",
    "lint": "eslint src",
    "test": "tsc --outDir out && node --test out/src/test/*.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vscode/vsce": "^3.1.1",
    "eslint": "^9.39.3",
    "oxfmt": "^0.75.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "contributes": {
    "configuration": {
      "title": "Scorpio",
      "properties": {
        "scorpio.artemis.apiBaseUrl": {
          "order": 1,
          "description": "Optional: the base URL of an Artemis server. Only used for Artemis sessions, which set it from ARTEMIS_URL.",
          "type": "string",
          "format": "uri",
          "editPresentation": "singlelineText"
        },
        "scorpio.defaults.repoPath": {
          "order": 3,
          "description": "The default to search for and clone repositories into - has to be an absolute path",
          "editPresentation": "singlelineText",
          "type": "string",
          "format": "path"
        }
      }
    },
    "commands": [
      {
        "command": "scorpio.restart",
        "category": "Scorpio",
        "title": "Restart Extension"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.1"
  }
}
