{
  "name": "artemis-scorpio",
  "displayName": "Artemis - Scorpio",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "private": true,
  "categories": [
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/EduIDE/scorpio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EduIDE/scorpio.git"
  },
  "publisher": "tum-aet",
  "main": "./dist/extension.js",
  "scripts": {
    "install:all": "npm install --no-scripts",
    "build": "webpack --mode production",
    "watch": "webpack --watch",
    "install:extension": "npm install --no-scripts",
    "build:extension": "webpack --mode production",
    "compile:extension": "webpack",
    "watch:extension": "webpack --watch",
    "lint": "eslint src",
    "pretest": "tsc -p . --outDir out",
    "test": "node --test $(find out/src -name '*.test.js')",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vscode/vsce": "^3.1.1",
    "eslint": "^9.39.3",
    "oxfmt": "^0.31.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "contributes": {
    "configuration": {
      "title": "Scorpio",
      "properties": {
        "scorpio.artemis.apiBaseUrl": {
          "order": 1,
          "description": "The base URL of the Artemis Server",
          "type": "string",
          "format": "uri",
          "editPresentation": "singlelineText",
          "default": "https://artemis.cit.tum.de"
        },
        "scorpio.defaults.repoPath": {
          "order": 3,
          "description": "The default to search for and clone repositories into - has to be an absolute path",
          "editPresentation": "singlelineText",
          "type": "string",
          "format": "path"
        },
        "scorpio.github.clientId": {
          "order": 10,
          "description": "Public client ID of the GitHub OAuth App to sign in to with the device flow (no client secret). Empty turns the GitHub features off. Overridden by SCORPIO_GITHUB_CLIENT_ID.",
          "type": "string",
          "default": ""
        },
        "scorpio.github.allowPrivateRepositories": {
          "order": 11,
          "description": "Allow asking for the repo scope to clone and push private repositories. Overridden by SCORPIO_GITHUB_PRIVATE_REPOS.",
          "type": "boolean",
          "default": true
        },
        "scorpio.github.host": {
          "order": 12,
          "description": "GitHub host, e.g. a GitHub Enterprise Server. Overridden by SCORPIO_GITHUB_HOST.",
          "type": "string",
          "default": "github.com"
        }
      }
    },
    "commands": [
      {
        "command": "scorpio.restart",
        "category": "Scorpio",
        "title": "Restart Extension"
      },
      {
        "command": "scorpio.github.signIn",
        "category": "Scorpio",
        "title": "Sign in to GitHub"
      },
      {
        "command": "scorpio.github.signOut",
        "category": "Scorpio",
        "title": "Sign out of GitHub"
      },
      {
        "command": "scorpio.github.push",
        "category": "Scorpio",
        "title": "Push to GitHub",
        "icon": "$(github)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "scorpio.github.push",
          "when": "scmProvider == git && scorpio.github.enabled",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "scorpio.github.signOut",
          "when": "scorpio.github.enabled"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  }
}
